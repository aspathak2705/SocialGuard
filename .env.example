# Backend Settings
APP_NAME=SocialGuard
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Frontend Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Durable Database Persistence (Supabase PostgreSQL / local PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# OpenRouter Explainability Service (Nemotron-3.5-Lightning)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=true
OPENROUTER_TIMEOUT_SECONDS=15.0
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1024

# Frontend Environment (used in frontend/.env.example)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

