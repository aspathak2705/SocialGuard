# Backend Settings
APP_NAME=SocialGuard
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Frontend Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment (used in frontend/.env.example)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
